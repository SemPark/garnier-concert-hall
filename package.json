{
  "name": "garnier-concert-hall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/audio-manifest.mjs && vite build",
    "typegen": "wrangler types",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx tests/integration.ts",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.0",
    "ws": "8.22.0"
  }
}
