{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garnier-concert-hall",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/audio/*"]},
  "durable_objects": {"bindings": [{"name": "VENUES", "class_name": "VenueRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["VenueRoom"]}],
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
