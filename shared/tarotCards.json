[
  {"id":0,"number":"0","nameKo":"바보","nameEn":"The Fool","interpretation":"새로운 시작을 두려워하지 마세요. 뜻밖의 즐거움이 기다리고 있어요."},
  {"id":1,"number":"I","nameKo":"마법사","nameEn":"The Magician","interpretation":"이미 가진 재능과 가능성이 소원을 이루는 힘이 될 거예요."},
  {"id":2,"number":"II","nameKo":"여사제","nameEn":"The High Priestess","interpretation":"조용히 마음을 들여다보면 필요한 답을 발견할 수 있어요."},
  {"id":3,"number":"III","nameKo":"여황제","nameEn":"The Empress","interpretation":"정성껏 키워온 일이 아름다운 결실을 맺을 거예요."},
  {"id":4,"number":"IV","nameKo":"황제","nameEn":"The Emperor","interpretation":"차근차근 쌓아온 노력이 든든한 기반이 되어줄 거예요."},
  {"id":5,"number":"V","nameKo":"교황","nameEn":"The Hierophant","interpretation":"좋은 조언과 소중한 만남이 새로운 길을 열어줄 거예요."},
  {"id":6,"number":"VI","nameKo":"연인","nameEn":"The Lovers","interpretation":"마음에 솔직한 선택이 좋은 인연과 조화로 이어질 거예요."},
  {"id":7,"number":"VII","nameKo":"전차","nameEn":"The Chariot","interpretation":"원하는 방향으로 힘차게 나아갈 용기가 생길 거예요."},
  {"id":8,"number":"VIII","nameKo":"힘","nameEn":"Strength","interpretation":"부드러운 용기와 인내가 생각보다 큰 힘을 발휘할 거예요."},
  {"id":9,"number":"IX","nameKo":"은둔자","nameEn":"The Hermit","interpretation":"잠시 자신에게 집중하면 진정 원하는 길이 보일 거예요."},
  {"id":10,"number":"X","nameKo":"운명의 수레바퀴","nameEn":"Wheel of Fortune","interpretation":"변화하는 흐름 속에서 새로운 기회를 만날 수 있어요."},
  {"id":11,"number":"XI","nameKo":"정의","nameEn":"Justice","interpretation":"진심 어린 선택과 노력은 의미 있는 결과로 돌아올 거예요."},
  {"id":12,"number":"XII","nameKo":"매달린 사람","nameEn":"The Hanged Man","interpretation":"잠시 멈춰 바라보면 새로운 해답이 떠오를 거예요."},
  {"id":13,"number":"XIII","nameKo":"죽음","nameEn":"Death","interpretation":"오래된 것을 내려놓으면 새로운 계절이 시작됩니다."},
  {"id":14,"number":"XIV","nameKo":"절제","nameEn":"Temperance","interpretation":"서두르지 않아도 괜찮아요. 조금씩 아름다운 균형을 찾을 거예요."},
  {"id":15,"number":"XV","nameKo":"악마","nameEn":"The Devil","interpretation":"나를 묶고 있던 것을 알아차리면 더 자유로워질 수 있어요."},
  {"id":16,"number":"XVI","nameKo":"탑","nameEn":"The Tower","interpretation":"흔들린 자리에서 이전보다 단단한 시작을 만들 수 있어요."},
  {"id":17,"number":"XVII","nameKo":"별","nameEn":"The Star","interpretation":"잊고 있던 희망이 다시 반짝이기 시작할 거예요."},
  {"id":18,"number":"XVIII","nameKo":"달","nameEn":"The Moon","interpretation":"흐릿했던 마음속 답이 조금씩 선명해질 거예요."},
  {"id":19,"number":"XIX","nameKo":"태양","nameEn":"The Sun","interpretation":"기쁨과 자신감이 일상을 더욱 환하게 비춰줄 거예요."},
  {"id":20,"number":"XX","nameKo":"심판","nameEn":"Judgement","interpretation":"새로운 깨달음이 다시 시작할 용기를 선물할 거예요."},
  {"id":21,"number":"XXI","nameKo":"세계","nameEn":"The World","interpretation":"이어온 여정이 아름다운 완성과 새로운 시작으로 이어질 거예요."}
]
