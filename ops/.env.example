# 복사할 대상: ops/.env (Git에서 제외됨)
# OPS_PORT=5180
# OPS_SITE_URL=https://your-venue.example.com

# Google Analytics 속성 ID (숫자). G-로 시작하는 측정 ID와 다릅니다.
GA4_PROPERTY_ID=
# 저장소 밖에 보관한 서비스 계정 JSON의 절대 경로
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare 읽기 전용 분석 토큰
CF_API_TOKEN=
# Workers 분석 (workers.dev 주소도 가능)
CF_ACCOUNT_ID=
CF_WORKER_NAME=
# 도메인(Zone) HTTP 분석: Cloudflare에서 관리하는 자체 도메인이 있는 경우
CF_ZONE_ID=
# 같은 Zone에 사이트가 여럿 있으면 분석할 호스트만 지정. URL이나 경로 제외.
CF_HOSTNAME=
# Cloudflare Web Analytics (선택): 사이트 태그. 설치용 beacon 토큰과 다릅니다.
CF_RUM_SITE_TAG=
